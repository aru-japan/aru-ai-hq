# ARu Studio — 接続設定
# このファイルを同じフォルダに .env という名前でコピーし、実際の値を入力してください。
# .env は絶対にコミット・共有しないこと。

# notion.so/my-integrations で作成したInternal Integrationのシークレット
NOTION_TOKEN=

# ARu Studioルートページ（司令室）のPage ID
# ページのURL末尾にある32文字のID（ハイフンなし、または付きでも可）
ARU_STUDIO_PAGE_ID=

# 以下は各データベース作成後にスクリプトが自動追記します（今は空でOK）
ARTICLES_DB_ID=
RESEARCH_DB_ID=
TRANSLATION_DB_ID=
SOURCE_LIBRARY_DB_ID=
EDITORIAL_CALENDAR_DB_ID=
EXPERIENCE_INTELLIGENCE_DB_ID=
SOURCE_MONITOR_DB_ID=
DASHBOARD_PAGE_ID=
LAW_UPDATE_DB_ID=
EVENT_CALENDAR_DB_ID=
SNS_QUEUE_DB_ID=

# 以下はVersion 4準備スクリプトが初回実行時に自動追記します（今は空でOK）
COVERAGE_ANALYSIS_PAGE_ID=
EDITORIAL_PLANNER_PAGE_ID=
DUPLICATE_PREVENTION_PAGE_ID=

# 以下はVersion 4 Phase 5（Editor Experience）スクリプトが初回実行時に自動追記します（今は空でOK）
EDITOR_HOME_PAGE_ID=
AI_COMMAND_CENTER_PAGE_ID=

# AI Gateway（scripts/ai_gateway.py）用。どちらか一方だけでも動作する
# Anthropic Console（console.anthropic.com）で発行
CLAUDE_API_KEY=
# OpenAI Platform（platform.openai.com）で発行
OPENAI_API_KEY=
